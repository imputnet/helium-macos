+# Copyright 2025 The Helium Authors
+# You can use, redistribute, and/or modify this source code under
+# the terms of the GPL-3.0 license that can be found in the LICENSE file.
+
+import("//build/config/mac/mac_sdk.gni")
+
+assert(is_mac)
+
+action("build_sparkle_framework") {
+  script = "build_sparkle_framework.py"
+  sources = [ "Package.swift" ]
+  outputs = [
+    "$root_out_dir/BinaryDelta",
+    "$root_out_dir/Sparkle.framework",
+  ]
+  args = [
+    rebase_path(root_out_dir, root_build_dir),
+    mac_deployment_target,
+  ]
+}
+
+bundle_data("sparkle_framework") {
+  public_deps = [ ":build_sparkle_framework" ]
+  sources = [ "$root_out_dir/Sparkle.framework" ]
+  outputs = [ "{{bundle_contents_dir}}/Frameworks/{{source_file_part}}" ]
+}
+
+config("sparkle_config") {
+  include_dirs = [ "//third_party/sparkle" ]
+  framework_dirs = [ root_out_dir ]
+  frameworks = [ "Sparkle.framework" ]
+}
+
+group("sparkle") {
+  public_deps = [ ":build_sparkle_framework" ]
+  public_configs = [ ":sparkle_config" ]
+}
+
+# GN doesn't pass ldflags from source sets on to the linker, so each binary
+# that loads Sparkle adds the matching rpath with one of these configs.
+config("sparkle_link_framework") {
+  ldflags = [
+    "-rpath",
+    "@loader_path/Frameworks",
+  ]
+}
+
+config("sparkle_link_test") {
+  ldflags = [
+    "-rpath",
+    "@executable_path",
+  ]
+}
