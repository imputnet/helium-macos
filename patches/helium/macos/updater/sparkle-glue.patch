+const PrefService* GetUpdatePrefs() {
+  ProfileManager* profile_manager = g_browser_process->profile_manager();
+  if (!profile_manager) {
+    return nullptr;
+  }
+
+  for (Profile* profile : profile_manager->GetLoadedProfiles()) {
+    if (helium::ShouldAccessUpdateService(*profile->GetPrefs())) {
+      return profile->GetPrefs();
+    }
+  }
+
+  return nullptr;
+}
+
+// Adds "Update Helium" to the app menu while an update waits for approval.
+class UpdateApprovalError : public GlobalError {
+ public:
+  Severity GetSeverity() override { return SEVERITY_LOW; }
+  bool HasMenuItem() override { return true; }
+  int MenuItemCommandID() override { return IDC_HELIUM_APPROVE_UPDATE; }
+  std::u16string MenuItemLabel() override {
+    return l10n_util::GetStringUTF16(IDS_HELIUM_APPROVE_UPDATE_MENU_ITEM);
+  }
+  void ExecuteMenuItem(BrowserWindowInterface* browser) override;
+  bool HasBubbleView() override { return false; }
+  bool HasShownBubbleView() override { return false; }
+  void ShowBubbleView(BrowserWindowInterface* browser) override {}
+  GlobalErrorBubbleViewBase* GetBubbleView() override { return nullptr; }
+};
+
+// Owns the SPUUpdater and keeps the latest status for new About pages.
+class SparkleUpdater {
+ public:
+  using StatusCallback =
+      base::RepeatingCallback<void(VersionUpdater::Status status,
+                                   int progress,
+                                   const std::u16string& message)>;
+
+  static SparkleUpdater& Get() {
+    static base::NoDestructor<SparkleUpdater> instance;
+    return *instance;
+  }
+
+  SparkleUpdater() = default;
+  SparkleUpdater(const SparkleUpdater&) = delete;
+  SparkleUpdater& operator=(const SparkleUpdater&) = delete;
+
+  void Start();
+  void CheckForUpdates();
+  base::CallbackListSubscription AddStatusCallback(StatusCallback callback);
+
+  void SetStatus(VersionUpdater::Status status,
+                 int progress = 0,
+                 const std::u16string& message = {});
+  void ReportError(NSError* error);
+  void SetPendingUpdate(NSString* version, void (^install_handler)(void));
+
+  // Sparkle couldn't install an update silently, so the user installs it from
+  // the app menu. macOS asks for an administrator password if needed.
+  void AwaitApproval(NSString* version, void (^reply)(SPUUserUpdateChoice));
+  void ApproveUpdate();
+  void CancelApproval();
+
+  std::optional<std::string> pending_version() const {
+    if (!pending_version_) {
+      return std::nullopt;
+    }
+
+    return base::SysNSStringToUTF8(pending_version_);
+  }
+
+  bool InstallPendingUpdate();
+
+ private:
+  void SetApprovalErrorShown(bool shown);
+
+  SPUUpdater* __strong updater_;
+  HeliumSparkleDelegate* __strong delegate_;
+  HeliumSparkleUserDriver* __strong user_driver_;
+
+  VersionUpdater::Status status_ = VersionUpdater::CHECKING;
+  int progress_ = 0;
+  std::u16string message_;
+  base::RepeatingCallbackList<
+      void(VersionUpdater::Status, int, const std::u16string&)>
+      status_callbacks_;
+
+  NSString* __strong pending_version_;
+  void (^install_handler_)(void);
+
+  UpdateApprovalError approval_error_;
+  void (^approval_reply_)(SPUUserUpdateChoice);
+};
+
+void UpdateApprovalError::ExecuteMenuItem(BrowserWindowInterface* browser) {
+  SparkleUpdater::Get().ApproveUpdate();
+}
+
+class VersionUpdaterSparkle : public VersionUpdater {
+ public:
+  VersionUpdaterSparkle() = default;
+  VersionUpdaterSparkle(const VersionUpdaterSparkle&) = delete;
+  VersionUpdaterSparkle& operator=(const VersionUpdaterSparkle&) = delete;
+  ~VersionUpdaterSparkle() override = default;
+
+  void CheckForUpdate(StatusCallback status_callback,
+                      PromoteCallback promote_callback) override {
+    status_callback_ = std::move(status_callback);
+    subscription_ = SparkleUpdater::Get().AddStatusCallback(base::BindRepeating(
+        &VersionUpdaterSparkle::OnStatus, base::Unretained(this)));
+    SparkleUpdater::Get().CheckForUpdates();
+  }
+
+  void PromoteUpdater() override {}
+
+ private:
+  void OnStatus(Status status, int progress, const std::u16string& message) {
+    status_callback_.Run(status, progress, false, false, std::string(), 0,
+                         message);
+  }
+
+  StatusCallback status_callback_;
+  base::CallbackListSubscription subscription_;
+};
+
