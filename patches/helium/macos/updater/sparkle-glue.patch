+    (void (^)(void))cancellation {
+}
+
+// Only reached when an update can't be installed silently, e.g. because the
+// user can't write to the app bundle.
+- (void)showUpdateFoundWithAppcastItem:(SUAppcastItem*)item
+                                 state:(SPUUserUpdateState*)state
+                                 reply:(void (^)(SPUUserUpdateChoice))reply {
+  // Already approved; the relaunch is still held until the user restarts.
+  if (state.stage == SPUUserUpdateStageInstalling) {
+    reply(SPUUserUpdateChoiceInstall);
+    return;
+  }
+
+  SparkleUpdater::Get().AwaitApproval(item.displayVersionString, reply);
