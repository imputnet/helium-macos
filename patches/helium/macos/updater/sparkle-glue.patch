+namespace {
+
+void SparkleUpdater::Start() {
+  DCHECK_CURRENTLY_ON(content::BrowserThread::UI);
+  if (updater_) {
+    // Profiles loaded later need the approval item too.
+    if (approval_reply_) {
+      SetApprovalErrorShown(true);
+    }
+    return;
+  }
+
+  delegate_ = [[HeliumSparkleDelegate alloc] init];
+  user_driver_ = [[HeliumSparkleUserDriver alloc] init];
+  updater_ = [[SPUUpdater alloc] initWithHostBundle:NSBundle.mainBundle
+                                  applicationBundle:NSBundle.mainBundle
+                                         userDriver:user_driver_
+                                           delegate:delegate_];
+
+  NSError* error = nil;
+  if (![updater_ startUpdater:&error]) {
+    ReportError(error);
+    updater_ = nil;
+    return;
+  }
+  // Don't wait for the next scheduled check.
+  [updater_ checkForUpdatesInBackground];
+}
+
+void SparkleUpdater::CheckForUpdates() {
+  DCHECK_CURRENTLY_ON(content::BrowserThread::UI);
+  if (!updater_ || !GetUpdatePrefs()) {
+    SetStatus(VersionUpdater::DISABLED);
+    return;
+  }
+
+  // Don't interrupt a pending update or a running session.
+  if (install_handler_ || updater_.sessionInProgress) {
+    status_callbacks_.Notify(status_, progress_, message_);
+    return;
+  }
+
+  SetStatus(VersionUpdater::CHECKING);
+  [updater_ checkForUpdatesInBackground];
+}
+
+base::CallbackListSubscription SparkleUpdater::AddStatusCallback(
+    StatusCallback callback) {
+  return status_callbacks_.Add(std::move(callback));
+}
+
+void SparkleUpdater::SetStatus(VersionUpdater::Status status,
+                               int progress,
+                               const std::u16string& message) {
+  DCHECK_CURRENTLY_ON(content::BrowserThread::UI);
+  // A downloaded update wins until relaunch.
+  if (install_handler_ && status != VersionUpdater::NEARLY_UPDATED) {
+    return;
+  }
+
+  status_ = status;
+  progress_ = progress;
+  // Rendered as HTML.
+  message_ = base::EscapeForHTML(message);
+  status_callbacks_.Notify(status_, progress_, message_);
+}
+
+void SparkleUpdater::ReportError(NSError* error) {
+  LOG(ERROR) << "Browser update failed: "
+             << base::SysNSStringToUTF8(error.localizedDescription);
+  // The session is over, so a held relaunch can't install anymore.
+  pending_version_ = nil;
+  install_handler_ = nil;
+  SetStatus(VersionUpdater::FAILED, 0,
+            base::SysNSStringToUTF16(error.localizedDescription));
+}
+
+void SparkleUpdater::SetPendingUpdate(NSString* version,
+                                      void (^install_handler)(void)) {
+  pending_version_ = version;
+  install_handler_ = install_handler;
+  SetStatus(VersionUpdater::NEARLY_UPDATED);
+}
+
+void SparkleUpdater::AwaitApproval(NSString* version,
+                                   void (^reply)(SPUUserUpdateChoice)) {
+  DCHECK_CURRENTLY_ON(content::BrowserThread::UI);
+  approval_reply_ = reply;
+  SetApprovalErrorShown(true);
+  SetStatus(VersionUpdater::FAILED, 0,
+            l10n_util::GetStringFUTF16(IDS_HELIUM_APPROVE_UPDATE_STATUS,
+                                       base::SysNSStringToUTF16(version)));
+}
+
+void SparkleUpdater::ApproveUpdate() {
+  DCHECK_CURRENTLY_ON(content::BrowserThread::UI);
+  if (!approval_reply_) {
+    return;
+  }
+
+  auto reply = approval_reply_;
+  approval_reply_ = nil;
+  SetApprovalErrorShown(false);
+  SetStatus(VersionUpdater::UPDATING);
+  reply(SPUUserUpdateChoiceInstall);
+}
+
+void SparkleUpdater::CancelApproval() {
+  DCHECK_CURRENTLY_ON(content::BrowserThread::UI);
+  approval_reply_ = nil;
+  SetApprovalErrorShown(false);
+}
+
+void SparkleUpdater::SetApprovalErrorShown(bool shown) {
+  ProfileManager* profile_manager = g_browser_process->profile_manager();
+  if (!profile_manager) {
+    return;
+  }
+
+  for (Profile* profile : profile_manager->GetLoadedProfiles()) {
+    GlobalErrorService* service =
+        GlobalErrorServiceFactory::GetForProfile(profile);
+    if (!service) {
+      continue;
+    }
+
+    const bool added =
+        std::ranges::contains(service->errors(), &approval_error_);
+    if (shown && !added) {
+      service->AddUnownedGlobalError(&approval_error_);
+    } else if (!shown && added) {
+      service->RemoveUnownedGlobalError(&approval_error_);
+    }
+  }
+}
+
+bool SparkleUpdater::InstallPendingUpdate() {
+  DCHECK_CURRENTLY_ON(content::BrowserThread::UI);
+  if (!install_handler_) {
+    return false;
+  }
+
+  install_handler_();
+  return true;
+}
+
+}  // namespace
+
+std::unique_ptr<VersionUpdater> VersionUpdater::Create(
+    content::WebContents* web_contents) {
+  return std::make_unique<VersionUpdaterSparkle>();
+}
+
+namespace helium {
+
+void StartSparkleUpdater() {
+  SparkleUpdater::Get().Start();
+}
+
+std::optional<std::string> GetSparklePendingUpdateVersion() {
+  return SparkleUpdater::Get().pending_version();
+}
+
+bool RelaunchToInstallSparkleUpdate() {
+  return SparkleUpdater::Get().InstallPendingUpdate();
+}
+
+}  // namespace helium
