+#!/usr/bin/env python3
+
+# Copyright 2025 The Helium Authors
+# You can use, redistribute, and/or modify this source code under
+# the terms of the GPL-3.0 license that can be found in the LICENSE file.
+"""Usage: build_sparkle_framework.py <out_dir> <macos_deployment_target>"""
+
+import os
+import subprocess
+import sys
+import tempfile
+
+SPARKLE_DIR = os.path.dirname(os.path.abspath(__file__))
+
+# Skip everything Helium doesn't use.
+BUILD_SETTINGS = {
+    'SPARKLE_BUILD_UI_BITS': '0',
+    'SPARKLE_BUILD_LEGACY_SUUPDATER': '0',
+    'SPARKLE_BUILD_LEGACY_DSA_SUPPORT': '0',
+    'SPARKLE_BUILD_LEGACY_DELTA_SUPPORT': '0',
+    'GENERATE_APPCAST_BUILD_LEGACY_DSA_SUPPORT': '0',
+    'SPARKLE_BUILD_PACKAGE_SUPPORT': '0',
+    'SPARKLE_COPY_LOCALIZATIONS': '0',
+    'SPARKLE_EMBED_INSTALLER_LAUNCHER_XPC_SERVICE': '0',
+    'SPARKLE_EMBED_DOWNLOADER_XPC_SERVICE': '0',
+    'SPARKLE_EMBED_INSTALLER_STATUS_XPC_SERVICE': '0',
+    'SPARKLE_EMBED_INSTALLER_CONNECTION_XPC_SERVICE': '0',
+    'ENABLE_MODULE_VERIFIER': 'NO',
+}
+
+
+def main():
+    out_dir, deployment_target = sys.argv[1:]
+    # Sparkle's scripts need the BSD tools (e.g. `ln -h`).
+    env = dict(os.environ, PATH='/usr/bin:/bin:/usr/sbin:/sbin')
+    with tempfile.TemporaryDirectory() as temp_dir:
+        settings = dict(BUILD_SETTINGS,
+                        CONFIGURATION_BUILD_DIR=os.path.abspath(out_dir),
+                        MACOSX_DEPLOYMENT_TARGET=deployment_target,
+                        PROJECT_TEMP_DIR=temp_dir,
+                        SYMROOT=temp_dir)
+        for target in ('Sparkle', 'BinaryDelta'):
+            result = subprocess.run(
+                ['xcodebuild', '-disableAutomaticPackageResolution',
+                 '-target', target, '-configuration', 'Release'] +
+                [f'{key}={value}' for key, value in settings.items()] +
+                ['build'],
+                cwd=SPARKLE_DIR,
+                env=env,
+                stdout=subprocess.PIPE,
+                stderr=subprocess.STDOUT,
+                text=True,
+                check=False)
+            if result.returncode != 0:
+                sys.stderr.write(result.stdout)
+                return result.returncode
+    return 0
+
+
+if __name__ == '__main__':
+    sys.exit(main())
