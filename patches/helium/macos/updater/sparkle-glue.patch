+                    acknowledgement:(void (^)(void))acknowledgement {
+  acknowledgement();
+}
+
+- (void)showUpdaterError:(NSError*)error
+         acknowledgement:(void (^)(void))acknowledgement {
+  acknowledgement();
+}
+
+- (void)showDownloadInitiatedWithCancellation:(void (^)(void))cancellation {
+}
+
+// Download fills the first half of the progress bar, extraction the second.
+- (void)showDownloadDidReceiveExpectedContentLength:(uint64_t)length {
+  _expectedLength = length;
+  _receivedLength = 0;
+}
+
+- (void)showDownloadDidReceiveDataOfLength:(uint64_t)length {
+  _receivedLength += length;
+  if (_expectedLength > 0) {
+    SparkleUpdater::Get().SetStatus(
+        VersionUpdater::UPDATING,
+        static_cast<int>(_receivedLength * 50 / _expectedLength));
+  }
+}
+
+- (void)showDownloadDidStartExtractingUpdate {
+  SparkleUpdater::Get().SetStatus(VersionUpdater::UPDATING, 50);
+}
+
+- (void)showExtractionReceivedProgress:(double)progress {
