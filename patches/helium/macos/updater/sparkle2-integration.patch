+def _AddSparkleKeys(plist, ed_key, check_interval):
+    plist['SUPublicEDKey'] = ed_key
+    plist['SUEnableAutomaticChecks'] = True
+    plist['SUAutomaticallyUpdate'] = True
+    plist['SUScheduledCheckInterval'] = check_interval
+    plist['SUVerifyUpdateBeforeExtraction'] = True
+
+
+def _RemoveSparkleKeys(plist):
+    """Removes any set Sparkle keys."""
+    _RemoveKeys(plist, *_SPARKLE_KEYS)
+
