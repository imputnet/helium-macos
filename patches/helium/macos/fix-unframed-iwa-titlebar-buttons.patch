+
+TEST(BrowserNativeWidgetWindowTest, UnframedTitlebarButtons) {
+  BrowserNativeWidgetWindow* browser_window = [[BrowserNativeWidgetWindow alloc]
+      initWithContentRect:NSMakeRect(0, 0, 600, 400)
+                styleMask:NSWindowStyleMaskTitled | NSWindowStyleMaskClosable |
+                          NSWindowStyleMaskMiniaturizable |
+                          NSWindowStyleMaskResizable
+                  backing:NSBackingStoreBuffered
+                    defer:NO];
+
+  const NSWindowButton buttons[] = {
+      NSWindowCloseButton, NSWindowMiniaturizeButton, NSWindowZoomButton};
+  constexpr NSWindowStyleMask kCapabilityMask =
+      NSWindowStyleMaskClosable | NSWindowStyleMaskMiniaturizable |
+      NSWindowStyleMaskResizable;
+  const NSWindowStyleMask capabilities =
+      browser_window.styleMask & kCapabilityMask;
+  for (NSWindowButton type : buttons) {
+    ASSERT_NE([browser_window standardWindowButton:type], nil);
+    EXPECT_FALSE([browser_window standardWindowButton:type].hidden);
+  }
+
+  [browser_window setTitlebarButtonsVisible:NO];
+  EXPECT_EQ(browser_window.styleMask & kCapabilityMask, capabilities);
+  for (NSWindowButton type : buttons) {
+    EXPECT_TRUE([browser_window standardWindowButton:type].hidden);
+  }
+
+  // AppKit may recreate buttons when the window's resize capability changes.
+  [browser_window
+      setStyleMask:browser_window.styleMask & ~NSWindowStyleMaskResizable];
+  [browser_window
+      setStyleMask:browser_window.styleMask | NSWindowStyleMaskResizable];
+  [browser_window setFrame:NSMakeRect(0, 0, 500, 300) display:NO];
+  EXPECT_EQ(browser_window.styleMask & kCapabilityMask, capabilities);
+  for (NSWindowButton type : buttons) {
+    EXPECT_TRUE([browser_window standardWindowButton:type].hidden);
+  }
+
+  [browser_window setTitlebarButtonsVisible:YES];
+  for (NSWindowButton type : buttons) {
+    EXPECT_FALSE([browser_window standardWindowButton:type].hidden);
+  }
 }
 
