+- (void)setTitlebarButtonsVisible:(BOOL)visible {
+  _titlebarButtonsHidden = !visible;
+  [self updateTitlebarButtonsVisibility];
+}
+
+// AppKit may replace the standard buttons when the window style changes.
+- (void)updateTitlebarButtonsVisibility {
+  for (NSWindowButton type :
+       {NSWindowCloseButton, NSWindowMiniaturizeButton, NSWindowZoomButton}) {
+    [self standardWindowButton:type].hidden = _titlebarButtonsHidden;
+  }
+}
+
+- (void)setStyleMask:(NSUInteger)styleMask {
+  [super setStyleMask:styleMask];
+  if (_titlebarButtonsHidden) {
+    [self updateTitlebarButtonsVisibility];
+  }
+}
+
 - (void)setAppKitFullscreenOverlaySuppressed:(BOOL)suppressed {
   _appKitFullscreenOverlaySuppressed = suppressed;
   [self updateAppKitFullscreenOverlay];
