+  if (!ShouldUseHeliumFullscreenWindowControls()) {
+    if (helium_fullscreen_controls_) {
+      helium_fullscreen_controls_host_->SetVisible(false);
+      helium_fullscreen_controls_host_->Detach();
+      [helium_fullscreen_controls_ restoreTitlebarButtons];
+      helium_fullscreen_controls_ = nil;
+    }
