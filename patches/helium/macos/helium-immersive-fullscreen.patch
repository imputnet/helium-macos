+  if (!window) {
+    return;
+  }
+  // Content fullscreen uses AppKit's titlebar. Keep the hosted controls for
+  // returning to browser fullscreen, but restore the native titlebar and input.
+  if (fullscreen_utils::IsInContentFullscreen(browser_view->browser())) {
+    if (helium_fullscreen_controls_host_) {
+      helium_fullscreen_controls_host_->SetVisible(false);
+      [helium_fullscreen_controls_ restoreTitlebarButtons];
+    }
+    return;
+  }
+  if (!helium_fullscreen_controls_host_) {
+    helium_fullscreen_controls_host_ =
+        AddChildView(std::make_unique<views::NativeViewHost>());
+    helium_fullscreen_controls_host_->SetVisible(false);
+  }
+  const gfx::Rect caption = gfx::ToEnclosingRect(GetCaptionButtonBounds().bounds);
