+int GetLastCommittedEntryId(content::WebContents* web_contents) {
+  content::NavigationEntry* entry =
+      web_contents->GetController().GetLastCommittedEntry();
+  return entry ? entry->GetUniqueID() : 0;
+}
+
+void RetranslateAfterLanguageInstall(
+    base::WeakPtr<content::WebContents> web_contents,
+    int entry_id,
+    const std::string& source_lang,
+    const std::string& target_lang,
+    bool installed) {
+  // Skip pages navigated to while the languages were downloading.
+  if (!installed || !web_contents || !entry_id ||
+      GetLastCommittedEntryId(web_contents.get()) != entry_id) {
+    return;
+  }
+  ChromeTranslateClient* client =
+      ChromeTranslateClient::FromWebContents(web_contents.get());
+  if (!client) {
+    return;
+  }
+  // Another wait may have translated the page already.
+  const translate::LanguageState& language_state = client->GetLanguageState();
+  if (language_state.IsPageTranslated() ||
+      language_state.translation_pending()) {
+    return;
+  }
+  client->GetTranslateManager()->TranslatePage(
+      source_lang, target_lang, /*triggered_from_menu=*/false,
+      translate::TranslationType::kManualUiReTranslation);
+}
+
+void OpenTranslationLanguageSettings(
+    base::WeakPtr<content::WebContents> web_contents,
+    int entry_id,
+    const std::string& source_lang,
+    const std::string& target_lang) {
+  platform_util::OpenExternal(GURL(kTranslationLanguagesSettingsUrl));
+  if (!web_contents) {
+    return;
+  }
+  // Translate as soon as the languages are downloaded.
+  translate::WaitForHeliumLanguageInstall(
+      source_lang, target_lang,
+      base::BindOnce(&RetranslateAfterLanguageInstall, std::move(web_contents),
+                     entry_id, source_lang, target_lang));
+}
