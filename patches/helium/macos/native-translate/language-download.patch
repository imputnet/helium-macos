+void GetHeliumLanguageStatus(
+    const std::string& source_lang,
+    const std::string& target_lang,
+    base::OnceCallback<void(HeliumLanguageStatus)> callback) {
+  Class availability_class = LanguageAvailabilityClass();
+  if (!availability_class) {
+    std::move(callback).Run(HeliumLanguageStatus::kUnknown);
+    return;
+  }
+
+  id<HeliumLTLanguageAvailability> availability =
+      [[availability_class alloc] init];
+  __block auto reply = base::BindPostTaskToCurrentDefault(std::move(callback));
+  [availability statusFromLanguage:LocaleForLanguage(source_lang)
+                        toLanguage:LocaleForLanguage(target_lang)
+                        completion:^(NSUInteger status) {
+                          // Keep |availability| alive until it replies.
+                          [availability self];
+                          std::move(reply).Run(ToLanguageStatus(status));
+                        }];
+}
