+Class LanguageAvailabilityClass() {
+  static Class availability_class = []() -> Class {
+    if (!GetTranslationClasses().session) {
+      return Nil;
+    }
+    Class cls = NSClassFromString(@"_LTLanguageAvailability");
+    if (![cls instancesRespondToSelector:
+                  @selector(statusFromLanguage:toLanguage:completion:)]) {
+      return Nil;
+    }
+    return cls;
+  }();
+  return availability_class;
+}
+
+HeliumLanguageStatus ToLanguageStatus(NSUInteger status) {
+  switch (status) {
+    case kLanguageStatusInstalled:
+      return HeliumLanguageStatus::kInstalled;
+    case kLanguageStatusSupported:
+      return HeliumLanguageStatus::kNeedsDownload;
+    case kLanguageStatusUnsupported:
+      return HeliumLanguageStatus::kUnsupported;
+    default:
+      return HeliumLanguageStatus::kUnknown;
+  }
+}
