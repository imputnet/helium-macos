+void PollLanguageInstall(const std::string& source_lang,
+                         const std::string& target_lang,
+                         base::TimeTicks deadline,
+                         base::OnceCallback<void(bool)> callback,
+                         HeliumLanguageStatus status) {
+  if (status == HeliumLanguageStatus::kInstalled) {
+    std::move(callback).Run(true);
+    return;
+  }
+  if (status == HeliumLanguageStatus::kUnsupported ||
+      base::TimeTicks::Now() >= deadline) {
+    std::move(callback).Run(false);
+    return;
+  }
+  base::SequencedTaskRunner::GetCurrentDefault()->PostDelayedTask(
+      FROM_HERE,
+      base::BindOnce(
+          &GetHeliumLanguageStatus, source_lang, target_lang,
+          base::BindOnce(&PollLanguageInstall, source_lang, target_lang,
+                         deadline, std::move(callback))),
+      kInstallPollInterval);
+}
