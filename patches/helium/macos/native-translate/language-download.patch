+    base::WeakPtr<actions::ActionItem> translate_action) {
+  const bool needs_download =
+      status == translate::HeliumLanguageStatus::kNeedsDownload;
+  auto closer =
+      std::make_unique<HeliumLanguageStatusBubbleCloser>(web_contents);
+  HeliumLanguageStatusBubbleCloser* closer_ptr = closer.get();
+  ui::DialogModel::Builder builder;
+  if (translate_action) {
+    // Let the translate icon close this bubble, like the translate bubble.
+    translate_action->SetIsShowingBubble(true);
+  }
+  builder.SetDialogDestroyingCallback(base::BindOnce(
+      [](base::WeakPtr<actions::ActionItem> translate_action,
+         std::unique_ptr<HeliumLanguageStatusBubbleCloser> closer) {
+        if (translate_action) {
+          translate_action->SetIsShowingBubble(false);
+        }
