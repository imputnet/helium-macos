+void TranslateBubbleView::OnHeliumLanguageStatus(
+    translate::HeliumLanguageStatus status) {
+  if ((status != translate::HeliumLanguageStatus::kNeedsDownload &&
+       status != translate::HeliumLanguageStatus::kUnsupported) ||
+      !GetAnchorView() || !web_contents()) {
+    return;
+  }
+
+  views::View* anchor_view = GetAnchorView();
+  const views::BubbleBorder::Arrow bubble_arrow = arrow();
+  const std::string source_lang = model_->GetSourceLanguageCode();
+  const std::string target_lang = model_->GetTargetLanguageCode();
+  const std::u16string source_name =
+      model_->GetSourceLanguageNameAt(model_->GetSourceLanguageIndex());
+  const std::u16string target_name =
+      model_->GetTargetLanguageNameAt(model_->GetTargetLanguageIndex());
+  content::WebContents* contents = web_contents();
+  base::WeakPtr<actions::ActionItem> translate_action;
+  if (tabs::TabInterface* tab =
+          tabs::TabInterface::MaybeGetFromContents(web_contents())) {
+    if (actions::ActionItem* item = actions::ActionManager::Get().FindAction(
+            kActionShowTranslate,
+            BrowserActions::From(tab->GetBrowserWindowInterface())
+                ->root_action_item())) {
+      translate_action = item->GetAsWeakPtr();
+    }
+  }
+
+  // Close synchronously, so closing doesn't reset the icon state of the new
+  // bubble. This deletes |this|.
+  GetWidget()->CloseNow();
+  ShowHeliumLanguageStatusBubble(
+      anchor_view, bubble_arrow, status, source_lang, target_lang, source_name,
+      target_name, contents, std::move(translate_action));
+}
