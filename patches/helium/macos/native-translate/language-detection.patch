+// Copyright 2026 The Helium Authors
+// You can use, redistribute, and/or modify this source code under
+// the terms of the GPL-3.0 license that can be found in the LICENSE file.
+
+#include "components/translate/content/browser/helium_platform_language_detection_mac.h"
+
+#import <Foundation/Foundation.h>
+#import <NaturalLanguage/NaturalLanguage.h>
+
+#include <string_view>
+#include <utility>
+
+#include "base/containers/fixed_flat_map.h"
+#include "base/functional/bind.h"
+#include "base/functional/callback.h"
+#include "base/strings/sys_string_conversions.h"
+#include "base/task/thread_pool.h"
+#include "components/language_detection/core/constants.h"
+#include "components/translate/core/common/translate_util.h"
+
+namespace translate {
+namespace {
+
+constexpr size_t kMaxDetectionCharacters = 10000;
+
+struct DetectionResult {
+  std::string language = language_detection::kUnknownLanguageCode;
+  bool is_reliable = false;
+};
+
+// Chromium's translate codes differ from Apple's for a few languages.
+std::string ToTranslateLanguageCode(NSString* language) {
+  static constexpr auto kSynonyms =
+      base::MakeFixedFlatMap<std::string_view, std::string_view>({
+          {"nb", "no"},
+          {"zh-Hans", "zh-CN"},
+          {"zh-Hant", "zh-TW"},
+      });
+  std::string code = base::SysNSStringToUTF8(language);
+  if (const auto it = kSynonyms.find(code); it != kSynonyms.end()) {
+    return std::string(it->second);
+  }
+  return code;
+}
+
+DetectionResult DetectLanguage(const std::u16string& text) {
+  @autoreleasepool {
+    NLLanguageRecognizer* recognizer = [[NLLanguageRecognizer alloc] init];
+    [recognizer processString:base::SysUTF16ToNSString(text)];
+
+    NLLanguage language = recognizer.dominantLanguage;
+    if (!language || [language isEqualToString:NLLanguageUndetermined]) {
+      return {};
+    }
+
+    NSNumber* confidence =
+        [recognizer languageHypothesesWithMaximum:1][language];
+    return {ToTranslateLanguageCode(language),
+            confidence.doubleValue > kTFLiteReliabilityThreshold};
+  }
+}
+
+}  // namespace
+
+void DetectLanguageWithPlatform(
+    std::u16string text,
+    base::OnceCallback<void(const std::string& language, bool is_reliable)>
+        callback) {
+  if (text.size() > kMaxDetectionCharacters) {
+    text.resize(kMaxDetectionCharacters);
+  }
+  base::ThreadPool::PostTaskAndReplyWithResult(
+      FROM_HERE, {base::MayBlock(), base::TaskPriority::USER_VISIBLE},
+      base::BindOnce(&DetectLanguage, std::move(text)),
+      base::BindOnce(
+          [](base::OnceCallback<void(const std::string&, bool)> callback,
+             DetectionResult result) {
+            std::move(callback).Run(result.language, result.is_reliable);
+          },
+          std::move(callback)));
+}
+
+}  // namespace translate
