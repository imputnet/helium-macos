+              queueAttributes(element);
+            }
+          }));
+    }
+  }
+
+  function isInsideSkippedElement(node) {
+    for (let element = node.parentElement; element;
+         element = element.parentElement) {
+      if (isSkippedElement(element)) {
+        return true;
+      }
+    }
+    return false;
+  }
+
+  function collect(root) {
+    if (root.nodeType === Node.TEXT_NODE) {
+      if (!isInsideSkippedElement(root)) {
+        queueTextNode(root);
+      }
+      return;
+    }
+    if (root.nodeType === Node.ELEMENT_NODE) {
+      if (isSkippedElement(root) || isInsideSkippedElement(root)) {
+        return;
+      }
+      queueAttributes(root);
+    } else if (
+        root.nodeType !== Node.DOCUMENT_NODE &&
+        root.nodeType !== Node.DOCUMENT_FRAGMENT_NODE) {
+      return;
+    }
+
+    const shadowRoots = [];
+    if (root.nodeType === Node.ELEMENT_NODE && root.shadowRoot) {
+      shadowRoots.push(root.shadowRoot);
+    }
+    const walker = document.createTreeWalker(
+        root, NodeFilter.SHOW_ELEMENT | NodeFilter.SHOW_TEXT, {
+          acceptNode(node) {
+            if (node.nodeType === Node.TEXT_NODE) {
+              return NodeFilter.FILTER_ACCEPT;
+            }
+            return isSkippedElement(node) ? NodeFilter.FILTER_REJECT :
+                                            NodeFilter.FILTER_ACCEPT;
+          },
+        });
+    for (let node = walker.nextNode(); node; node = walker.nextNode()) {
+      if (node.nodeType === Node.TEXT_NODE) {
+        queueTextNode(node);
+        continue;
+      }
+      queueAttributes(node);
+      if (node.shadowRoot) {
+        shadowRoots.push(node.shadowRoot);
+      }
+    }
+    for (const shadowRoot of shadowRoots) {
+      // Observers don't see into shadow trees from the document.
+      if (observer) {
+        observer.observe(shadowRoot, OBSERVER_OPTIONS);
+      }
+      collect(shadowRoot);
+    }
+  }
+
+  function collectDocument() {
+    const title = document.querySelector('head > title');
+    if (title && !isSkippedElement(title)) {
+      for (const child of title.childNodes) {
+        if (child.nodeType === Node.TEXT_NODE) {
+          queueTextNode(child);
+        }
+      }
+    }
+    if (document.body) {
+      collect(document.body);
+    }
+  }
+
+  function handleMutations(records) {
+    for (const record of records) {
+      if (record.type === 'childList') {
+        for (const node of record.addedNodes) {
+          collect(node);
+        }
+      } else if (record.type === 'characterData') {
+        // The page replaced translated text, so its value is the new original.
+        const entry = translated.get(record.target);
+        if (entry && record.target.nodeValue !== entry.value) {
+          translated.delete(record.target);
+        }
+        if (!isInsideSkippedElement(record.target)) {
+          queueTextNode(record.target);
+        }
+      } else if (record.type === 'attributes') {
+        const key = attributeKey(record.target, record.attributeName);
+        const entry = translated.get(key);
+        if (entry &&
+            record.target.getAttribute(record.attributeName) !== entry.value) {
+          translated.delete(key);
+        }
+        if (!isSkippedElement(record.target) &&
+            !isInsideSkippedElement(record.target)) {
+          queueAttributes(record.target);
+        }
+      }
+    }
+  }
+
+  // Puts the original text back, unless the page changed it since.
+  function restoreOriginal(entry) {
+    const segment = entry.segment;
+    if (segment.get() === entry.value) {
+      segment.set(segment.original);
+    }
+  }
+
+  function restoreAll() {
+    for (const entry of translated.values()) {
+      restoreOriginal(entry);
+    }
