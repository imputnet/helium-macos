+  function startObserving() {
+    if (observer) {
+      return;
+    }
+    observer = new MutationObserver(handleMutations);
+    observer.observe(document.documentElement, OBSERVER_OPTIONS);
+  }
+
+  function stopObserving() {
+    if (observer) {
+      observer.disconnect();
+      observer = null;
+    }
+  }
+
+  function reset() {
+    stopObserving();
+    pending = [];
+    queued = new Set();
+    inFlight = null;
+    finished = false;
+    error = false;
+    errorCode = ERROR['NONE'];
+    consecutiveFailures = 0;
+    pollsSincePrune = 0;
+    translationTime = 0;
