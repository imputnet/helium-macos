+void TranslateAgent::PumpNativeTranslation() {
+  if (native_request_in_flight_) {
+    return;
+  }
+
+  // Executing script may spin a nested run loop that detaches the frame and
+  // deletes |this|.
+  auto weak_this = weak_pointer_factory_.GetWeakPtr();
+  const std::string request =
+      ExecuteScriptAndGetStringResult("cr.googleTranslate.takeNativeRequest()");
+  if (!weak_this) {
+    return;
+  }
+  if (request.empty()) {
+    const bool active =
+        ExecuteScriptAndGetBoolResult("cr.googleTranslate.nativeActive", false);
+    if (weak_this && active) {
+      ScheduleNativeTranslationPump(kNativeTranslatePollDelayMs);
+    }
+    return;
+  }
+
+  std::optional<base::ListValue> parsed = base::JSONReader::ReadList(
+      request, base::JSON_PARSE_RFC | base::JSON_REPLACE_INVALID_CHARACTERS);
+  std::vector<std::u16string> texts;
+  bool valid = parsed && !parsed->empty();
+  if (valid) {
+    for (const base::Value& text : *parsed) {
+      if (!text.is_string()) {
+        valid = false;
+        break;
+      }
+      texts.push_back(base::UTF8ToUTF16(text.GetString()));
+    }
+  }
+  if (!valid) {
+    SendNativeTranslateResponse(std::nullopt, std::string(),
+                                TranslateErrors::UNEXPECTED_SCRIPT_ERROR);
+    if (weak_this) {
+      ScheduleNativeTranslationPump(kNativeTranslatePollDelayMs);
+    }
+    return;
+  }
+
+  native_request_in_flight_ = true;
+  const int request_id = ++native_request_id_;
+  // Fail the batch if the browser drops the request or doesn't reply.
+  GetNativeTranslator()->TranslateText(
+      source_lang_, target_lang_, std::move(texts),
+      mojo::WrapCallbackWithDefaultInvokeIfNotRun(
+          base::BindOnce(&TranslateAgent::OnNativeTranslateResponse,
+                         weak_method_factory_.GetWeakPtr(), request_id),
+          std::nullopt, std::string(), TranslateErrors::TRANSLATION_ERROR));
+  translate_task_runner_->PostDelayedTask(
+      FROM_HERE,
+      base::BindOnce(&TranslateAgent::OnNativeTranslateResponse,
+                     weak_method_factory_.GetWeakPtr(), request_id,
+                     std::optional<std::vector<std::u16string>>(),
+                     std::string(), TranslateErrors::TRANSLATION_TIMEOUT),
+      AdjustDelay(kNativeTranslateTimeoutMs));
+}
+
+void TranslateAgent::ScheduleNativeTranslationPump(int delay_in_milliseconds) {
+  translate_task_runner_->PostDelayedTask(
+      FROM_HERE,
+      base::BindOnce(&TranslateAgent::PumpNativeTranslation,
+                     weak_method_factory_.GetWeakPtr()),
+      AdjustDelay(delay_in_milliseconds));
+}
+
+void TranslateAgent::OnNativeTranslateResponse(
+    int request_id,
+    const std::optional<std::vector<std::u16string>>& translations,
+    const std::string& source_lang,
+    TranslateErrors error) {
+  if (!native_request_in_flight_ || request_id != native_request_id_) {
+    return;
+  }
+  native_request_in_flight_ = false;
+
+  auto weak_this = weak_pointer_factory_.GetWeakPtr();
+  SendNativeTranslateResponse(translations, source_lang, error);
+  if (!weak_this) {
+    return;
+  }
+
+  ScheduleNativeTranslationPump(0);
+}
+
+void TranslateAgent::SendNativeTranslateResponse(
+    const std::optional<std::vector<std::u16string>>& translations,
+    const std::string& source_lang,
+    TranslateErrors error) {
+  WebLocalFrame* main_frame = render_frame()->GetWebFrame();
+  if (!main_frame) {
+    return;
+  }
+
+  std::string translations_json = "null";
+  if (translations && error == TranslateErrors::NONE) {
+    base::ListValue list;
+    for (const std::u16string& translation : *translations) {
+      list.Append(translation);
+    }
+    translations_json = base::WriteJson(list).value_or("null");
+  }
+
+  // Not ASCII-only, so ExecuteScript() can't be used.
+  const std::string script = "cr.googleTranslate.onNativeResponse(" +
+                             translations_json + "," +
+                             base::NumberToString(static_cast<int>(error)) +
+                             "," + base::GetQuotedJSONString(source_lang) + ")";
+  main_frame->ExecuteScriptInIsolatedWorld(
+      world_id_, WebScriptSource(WebString::FromUtf8(script)),
+      blink::BackForwardCacheAware::kAllow);
+}
+
+const mojo::Remote<mojom::NativeTranslator>&
+TranslateAgent::GetNativeTranslator() {
+  if (native_translator_ && !native_translator_.is_connected()) {
+    native_translator_.reset();
+  }
+  if (!native_translator_) {
+    render_frame()->GetBrowserInterfaceBroker().GetInterface(
+        native_translator_.BindNewPipeAndPassReceiver(translate_task_runner_));
+  }
+  return native_translator_;
+}
