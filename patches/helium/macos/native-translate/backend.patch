+void BindNativeTranslator(
+    content::RenderFrameHost* render_frame_host,
+    mojo::PendingReceiver<translate::mojom::NativeTranslator> receiver) {
+  if (!IsHeliumNativeTranslateEnabled() ||
+      !IsHeliumNativeTranslatorAvailable()) {
+    return;
+  }
+
+  if (!render_frame_host->IsInPrimaryMainFrame()) {
+    return;
+  }
+
+  CreateHeliumNativeTranslator(render_frame_host, std::move(receiver));
+}
