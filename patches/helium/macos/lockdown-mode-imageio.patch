--- a/content/browser/sandbox_parameters_mac.mm
+++ b/content/browser/sandbox_parameters_mac.mm
@@ -4,8 +4,12 @@
 
 #include "content/browser/sandbox_parameters_mac.h"
 
+#import <Foundation/Foundation.h>
+
+#include <sys/sysctl.h>
 #include <unistd.h>
 
+#include <cerrno>
 #include <optional>
 
 #include "base/apple/bundle_locations.h"
@@ -42,6 +46,11 @@ namespace {
 BASE_FEATURE(kMacSandboxDistributedNotifications,
              base::FEATURE_DISABLED_BY_DEFAULT);
 
+// Allows the renderer sandbox to look up Apple's ImageIO XPC service when
+// Lockdown Mode is active. macOS may remote ImageIO work, including emoji
+// rendering, to this service.
+BASE_FEATURE(kMacSandboxRemoteAppleImageIO, base::FEATURE_ENABLED_BY_DEFAULT);
+
 // If enabled, the macOS sandbox for the Network process will allow read and
 // write file access to the user's cache and temp directory
 // (https://crbug.com/527885521).
@@ -64,6 +73,25 @@ std::optional<base::FilePath>& GetNetwor
   return *network_test_certs_dir;
 }
 
+bool IsLockdownModeEnabled() {
+  int lockdown_mode_state = 0;
+  size_t size = sizeof(lockdown_mode_state);
+  if (sysctlbyname("security.mac.lockdown_mode_state", &lockdown_mode_state,
+                   &size, nullptr, 0) == 0) {
+    return lockdown_mode_state == 1;
+  }
+  if (errno != ENOENT || base::mac::MacOSMajorVersion() != 13) {
+    return false;
+  }
+
+  // Ventura 13.0 does not expose this sysctl. Use its global preference when
+  // the running Ventura kernel lacks it.
+  NSDictionary* global_domain = [[NSUserDefaults standardUserDefaults]
+      persistentDomainForName:NSGlobalDomain];
+  id value = global_domain[@"LDMGlobalEnabled"];
+  return [value respondsToSelector:@selector(boolValue)] && [value boolValue];
+}
+
 // Produce the OS version as an integer "1010", etc. and pass that to the
 // profile. The profile converts the string back to a number and can do
 // comparison operations on OS version.
@@ -126,6 +154,10 @@ void SetupCommonSandboxParameters(
   CHECK(serializer->SetBooleanParameter(
       sandbox::policy::kParamEnableDistributedNotifications,
       base::FeatureList::IsEnabled(kMacSandboxDistributedNotifications)));
+  CHECK(serializer->SetBooleanParameter(
+      sandbox::policy::kParamAllowRemoteAppleImageio,
+      base::FeatureList::IsEnabled(kMacSandboxRemoteAppleImageIO) &&
+          IsLockdownModeEnabled()));
 
   std::string bundle_path =
       sandbox::policy::GetCanonicalPath(base::apple::MainBundlePath()).value();
--- a/sandbox/policy/mac/common.sb
+++ b/sandbox/policy/mac/common.sb
@@ -34,6 +34,10 @@
 ; Sandboxed processes which use Metal may need to disable the shader cache.
 (define disable-metal-shader-cache "DISABLE_METAL_SHADER_CACHE")
 
+; Whether to allow ImageIO to use its out-of-process XPC service when
+; Lockdown Mode is active.
+(define allow-remote-apple-imageio "ALLOW_REMOTE_APPLE_IMAGEIO")
+
 ; --enable-sandbox-logging causes the sandbox to log failures to the syslog.
 (if (param-true? disable-sandbox-denial-logging)
   (deny default (with no-log))
--- a/sandbox/policy/mac/renderer.sb
+++ b/sandbox/policy/mac/renderer.sb
@@ -84,6 +84,11 @@
   (global-name "com.apple.system.notification_center")  ; https://crbug.com/792217
 )
 
+; macOS Lockdown Mode may remote ImageIO work, including emoji rendering, to
+; this XPC service.
+(if (param-true? allow-remote-apple-imageio)
+  (allow mach-lookup (global-name "com.apple.ImageIOXPCService")))
+
 (if (param-true? enable-distributed-notifications)
   (allow mach-lookup
     (global-name "com.apple.distributed_notifications@Uv3")
